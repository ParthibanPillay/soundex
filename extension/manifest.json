{
  "manifest_version": 3,
  "name": "Soundex",
  "version": "1.0",
  "description": "Runs the Soundex Discord presence while YouTube Music is open.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "action": { "default_title": "Soundex: click to hide/show presence" },
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [{ "matches": ["https://music.youtube.com/*"], "js": ["content.js"] }],
  "background": { "service_worker": "background.js" }
}
